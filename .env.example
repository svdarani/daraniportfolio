# ==========================================
# Environment Variables for Darani Portfolio
# ==========================================

# Optional: GitHub Personal Access Token for live contribution graphs and stats
# If omitted, graceful fallbacks and static activity mock data are rendered
GITHUB_TOKEN=

# Optional: Resend or SendGrid API Key for forwarding /api/contact messages to your email
# If omitted, contact messages log safely in server stdout and return success
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=darani0906@gmail.com

# Site URL for metadata / Open Graph previews
NEXT_PUBLIC_SITE_URL=https://darani-portfolio.vercel.app
